{
  "name": "Ripple (Flutter)",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "vscode",
  "postCreateCommand": "flutter --version && flutter pub get && echo '' && echo 'Ripple is ready — Flutter installed, packages fetched. Open the Command Palette → Tasks: Run Task → Ripple: run (web).' && echo ''",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "Ripple web preview",
      "onAutoForward": "openPreview"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "Dart-Code.dart-code",
        "Dart-Code.flutter"
      ],
      "settings": {
        "dart.flutterHotReloadOnSave": "manual",
        "files.watcherExclude": {
          "**/.dart_tool/**": true
        }
      }
    }
  }
}
